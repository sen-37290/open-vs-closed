{
  "$schema": "https://app.kilo.ai/config.json",

  // ---------------------------------------------------------------------
  // open-vs-closed A/B harness — PINNED HARNESS CONFIGURATION
  //
  // ONE MODEL PER RUN. A run is: one human prompt handed to one model, which
  // then does whatever it decides to do — including spawning subagents and
  // assigning them roles. Every turn of that run, at every depth, uses the
  // SAME model. The experiment compares two whole systems, GLM-5.3 and
  // Fable 5, not two roles inside one system.
  //
  // Therefore NO agent below declares a `model`. In Kilo an agent without an
  // explicit model inherits the session's model, verified empirically via
  // per-message modelID telemetry. run-one.sh sets that single model per run
  // through KILO_CONFIG_CONTENT and `--model`, and metadata.json afterwards
  // asserts that exactly one model served the entire run.
  //
  // Do not add a `model` field to any agent here. Doing so would silently
  // introduce a second model into one arm and invalidate the comparison.
  //
  // This file is identical for both arms. Do not hand-edit during a campaign.
  // ---------------------------------------------------------------------

  // The skill's protocol has the model delegate to fresh subagents, which may
  // delegate further. Kilo's default is 1, which would silently prevent any
  // quality gauntlet from happening while the run still reported success.
  // The skill forbids imposing a recursion-depth limit and kilo has no
  // "unlimited" sentinel, so this sits far beyond any plausible topology.
  "subagent_depth": 1000000,

  // Autonomous execution. With `kilo run --auto`, no tool call may block on
  // human approval. `question` is denied outright so a run cannot stall
  // waiting for an answer that will never come.
  "permission": {
    "bash": "allow",
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "external_directory": "allow",
    "question": "deny",
    "doom_loop": "allow"
  },

  "agent": {
    // Subagent types the model MAY use if it chooses to follow the skill's
    // delegation protocol. Their existence is an available capability, not an
    // instruction: nothing here dictates how many are spawned, in what order,
    // or whether they are used at all. That is the model's decision and is
    // part of what the experiment measures.
    //
    // Neither declares a model. Both inherit the run's single model.
    "oneshot-lead": {
      "mode": "subagent",
      "description": "Owns one website experiment end to end in its own run directory, with no inherited conversation history.",
      "prompt": "Your complete role definition, run identity, assigned paths, operational envelopes and prompt are supplied verbatim in the dispatch message you receive. That dispatch is authoritative.\n\nYou start with no inherited conversation history and must not ask for any. Work autonomously to a terminal state. Never ask the human a question; no human is available during this run. If you reach a genuine blocker, record it honestly rather than stalling.\n\nStay inside your assigned run directory. Never inspect or compare any sibling run. Build, test, validate and package locally only: never upload, deploy, publish, or push anything.",
      "permission": {
        "bash": "allow", "edit": "allow", "read": "allow", "glob": "allow",
        "grep": "allow", "list": "allow", "task": "allow", "todowrite": "allow",
        "webfetch": "allow", "websearch": "allow", "lsp": "allow",
        "external_directory": "allow", "question": "deny", "doom_loop": "allow"
      }
    },

    "oneshot-critic": {
      "mode": "subagent",
      "description": "Fresh read-only reviewer of a built artifact. Inspects the real rendered result rather than a builder summary.",
      "prompt": "Your complete role definition is supplied verbatim in the dispatch message you receive. That dispatch is authoritative.\n\nYou start with no inherited builder conversation and must not request the builder's rationale, progress narrative, self-assessment, or implementation history. Never accept a prose summary in place of opening, rendering and exercising the actual artifact.\n\nYou are read-only: inspect, render and exercise the artifact, but never edit, create or delete any file in workspace/ or artifact/.",
      "permission": {
        "bash": "allow", "read": "allow", "glob": "allow", "grep": "allow",
        "list": "allow", "webfetch": "allow", "websearch": "allow",
        "todowrite": "allow", "edit": "deny", "task": "deny",
        "question": "deny", "doom_loop": "allow"
      }
    }
  }
}
