# --- secrets (never committed) --------------------------------------------
experiment-config/models.env
*.env
!experiment-config/models.example.env
.env
.env.*
*.key
*.pem
auth.json

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp

# --- caches and dependencies that must not be versioned -------------------
/__pycache__/
/*.py[cod]
/.pytest_cache/
/.ruff_cache/
/.venv/
/node_modules/

# --- uv ---------------------------------------------------------------------
/.venv/
# uv.lock IS committed: it pins the interpreter/dep resolution for both arms.
/scripts/__pycache__/

# --- temporary worktrees ---------------------------------------------------
.worktrees/
*.tmp.d/

# ---------------------------------------------------------------------------
# runs/ is LOCAL-ONLY and deliberately untracked.
#
# It holds the experimental record: sealed prompts, built artifacts, workspace
# source, gauntlet evidence, logs, metadata, provenance receipts and the .tmp/
# retained for failed runs. That record still matters and is still produced and
# preserved on disk exactly as before -- it is simply not repository content.
# Git is a poor store for hundreds of megabytes of generated sites and
# screenshots, and this repository is the HARNESS, not the results.
#
# Back results up deliberately (copy, archive, or object storage) rather than
# relying on git to hold them.
#
# STILL TRACKED:
#   metadata/    small cross-run pair and batch records
#   .kilo/       the pinned skill and the pinned harness configuration
#   prompts/     the sealed benchmark prompts
# ---------------------------------------------------------------------------
/runs/

# ---------------------------------------------------------------------------
# Inside run directories: exclude reconstructible dependency trees and caches,
# keep everything that is actual experimental evidence.
#
# EXCLUDED (not evidence):
#   node_modules/      reconstructible from the lockfile the run already keeps
#   .harness-tmp/      this harness's own scratch (kilo, compile caches)
#   *-cache/ caches    npm/node/vite/parcel compile caches
#
# KEPT (evidence, deliberately):
#   artifact/          the deliverable
#   workspace/         model-authored source, and workspace/evidence/ captures
#   .tmp/              the model's own scratch and verification captures,
#                      which the skill requires be RETAINED for every failed run
#   run.json, worker-report.json, metadata.json, status.txt,
#   agent.log, stderr.log, interventions.jsonl, .finalization.json,
#   directional-controls.txt, catalog-validate.txt, .oneshot-provenance/
# ---------------------------------------------------------------------------
runs/**/node_modules/
runs/**/.harness-tmp/
runs/**/node-compile-cache/
runs/**/npm-cache/
runs/**/.npm/
runs/**/.cache/
runs/**/.vite/
runs/**/.parcel-cache/
runs/**/.next/
runs/**/.turbo/
runs/**/__pycache__/
runs/**/.venv/
runs/**/venv/

# derived from the kilo session store; large, regenerate with scripts/export-trajectory.sh
/trajectories/
