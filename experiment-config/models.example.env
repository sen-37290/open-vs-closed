# ---------------------------------------------------------------------------
# open-vs-closed — model configuration
#
#   cp experiment-config/models.example.env experiment-config/models.env
#   then fill in the real key. models.env is gitignored; this file is not.
#   NEVER put a real key in this file.
# ---------------------------------------------------------------------------

# --- credentials -----------------------------------------------------------
# One provider serves every role, so both arms share an identical transport,
# rate-limit pool and request path. Only the model id differs.
OPENROUTER_API_KEY=<your-openrouter-key>

# --- the treatment variable: THE model ------------------------------------
# One model per run. The model below runs the ENTIRE system for its arm: the
# initial session and every subagent it chooses to spawn, at every depth.
# These two are the things being compared.
GLM_PROVIDER=openrouter
GLM_MODEL=z-ai/glm-5.3

FABLE_PROVIDER=openrouter
FABLE_MODEL=anthropic/claude-fable-5

# --- run policy ------------------------------------------------------------
# Wall-clock budget per run, enforced by run-one.sh from OUTSIDE the agent.
# It is never disclosed to the lead, so it cannot act as a budget that shapes
# the lead's behaviour. On expiry the run is terminated and recorded as failed
# with partial artifacts preserved. It is never retried. 14400 = 4 hours.
RUN_TIMEOUT_SECONDS=14400

# Maximum concurrent runs in run-all.sh. Never unlimited.
MAX_PARALLEL=2

# --- identity --------------------------------------------------------------
HARNESS_NAME=kilo-cli
EXPERIMENT_NAME=open-vs-closed

# --- optional --------------------------------------------------------------
# Liveness heartbeat interval in seconds. The skill's band is 120-300.
# MONITOR_INTERVAL_SECONDS=180
#
# Python >= 3.11 for the skill helpers. Auto-discovered if unset.
# ONESHOT_WEBSITES_PYTHON=/opt/homebrew/bin/python3.12
